# Copy to .env (git-ignored) and fill in. Never commit .env.
# Kalshi API key (or save it on the dashboard's Connection page instead; the dashboard copy wins).
KALSHI_KEY_ID=
# Path to the private key file, or the PEM itself with \n for line breaks.
KALSHI_PRIVATE_KEY=
# LIVE_SMALL can only be selected when this is exactly true. Leave false for PAPER/SHADOW.
LIVE_TRADING_ENABLED=false
# Maximum contracts per live entry (LIVE_SMALL always sends 1).
KALSHI_LIVE_MAX_CONTRACTS=1
# Optional: alternative data directory (tests and harnesses).
# KALSHI_DATA_DIR=
